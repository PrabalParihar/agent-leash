{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Grep|Glob|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agent-leash/leash.py\" hook", "timeout": 30 }] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agent-leash/leash.py\" hook", "timeout": 30 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agent-leash/leash.py\" hook", "timeout": 30 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"$HOME/.agent-leash/leash.py\" hook", "timeout": 600 }] }
    ]
  }
}
